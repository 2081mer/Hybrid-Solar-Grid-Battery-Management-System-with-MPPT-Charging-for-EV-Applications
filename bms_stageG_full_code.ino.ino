// =================================================================
//  Setup / Loop
// =================================================================
void setup() {
  digitalWrite(PIN_SD, HIGH);
  pinMode(PIN_SD, OUTPUT);
  digitalWrite(PIN_SD, HIGH);

  const int outs[] = {PIN_RLY_SOLAR, PIN_RLY_GRID, PIN_RLY_LOAD, PIN_RLY_EMERG, PIN_BUZZ};
  for(int p : outs) { pinMode(p, OUTPUT); digitalWrite(p, LOW); }

  Serial.begin(115200);
  delay(400);
  Serial.println(F("\n=== BMS Stage G Full ==="));
  Serial.println(F("Solar/Grid + MPPT + CC-CV + Emergency"));

  analogReadResolution(12);
  analogSetAttenuation(ADC_11db);

  prefs.begin("bms", false);
  kPanel = prefs.getFloat("kPanel", kPanel);
  kPack  = prefs.getFloat("kPack",  kPack);
  kMid   = prefs.getFloat("kMid",   kMid);
  kLow   = prefs.getFloat("kLow",   kLow);
  I_CC   = prefs.getFloat("I_CC",   I_CC);
  V_CV   = prefs.getFloat("V_CV",   V_CV);
  I_TERM = prefs.getFloat("I_TERM", I_TERM);

  Wire.begin(PIN_LCD_SDA, PIN_LCD_SCL);
  lcd.init();
  lcd.backlight();
  lcd.print("Stage G Full");
  lcd.setCursor(0,1); lcd.print("Solar/Grid BMS");

  pwmInit();
  applyRatio(0);
  zeroCurrentSensors();

#ifdef USE_IOT_CLOUD
  initProperties();
  ArduinoCloud.begin(ArduinoIoTPreferredConnection);
  setDebugMessageLevel(2);
  ArduinoCloud.printDebugInfo();
#endif

  lastCmdMs = millis();
  printHelp();
}

void loop() {
  handleSerial();

  uint32_t now = millis();
  if(now - tPo   >= PO_PERIOD_MS) { tPo = now; controlTick(); }
  if(now - tSlow >= 60)           { tSlow = now; slowTick(); }
  updateLcd();
  digitalWrite(PIN_BUZZ, buzzMode==1 ? HIGH : LOW);

  if(streaming && now - tStream >= 1000) {
    tStream = now;
    printReport();
  }

#ifdef USE_IOT_CLOUD
  ArduinoCloud.update();
  updateIoT();
#endif
}